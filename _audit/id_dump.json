 },
 {
  "front": "动词 + 了",
  "ar": "الفعل+<b>了</b> = الفعل اكتمل. مع مفعول محدَّد: <span style='color:var(--muted)'>我买了一本书</span> · مع مفعول غير محدَّد: <span style='color:var(--muted)'>我买了书了</span> · النفي: <span style='color:var(--muted)'>我没有买</span> · السؤال: <b>…了没有؟</b>",
  "en": "Verb + <b>了</b> = the action is completed. With a specific object: <span style='color:var(--muted)'>我买了一本书</span> · With an unspecified object: <span style='color:var(--muted)'>我买了书了</span> · Negative: <span style='color:var(--muted)'>我没有买</span> · Question: <b>…了没有？</b>",
  "type": "",
  "sub": "الفعل المكتمل"
 },
 {
  "front": "因为…所以…",
  "ar": "<b>因为</b> = السبب، <b>所以</b> = النتيجة: <span style='color:var(--muted)'>因为感到寂寞，所以很难过</span><br>ويمكن استخدام كلٍّ منهما منفرداً.",
  "en": "<b>因为</b> = cause, <b>所以</b> = result: <span style='color:var(--muted)'>因为感到寂寞，所以很难过</span><br>Each can also be used alone.",
  "type": "",
  "sub": "السبب والنتيجة"
 },
 {
  "front": "就 (القليل)",
  "ar": "<b>就</b> قبل العدد = «فقط»: <span style='color:var(--muted)'>就吃了一些鱼和牛肉</span> (أكلت القليل فقط)",
  "en": "<b>就</b> before a quantity = \"only\": <span style='color:var(--muted)'>就吃了一些鱼和牛肉</span> (ate only a little)",
