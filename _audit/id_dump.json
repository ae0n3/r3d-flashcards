 {
  "front": "喂，是田芳吗？",
  "ar": "ألو، هل هذه تيان فانغ؟",
  "en": "Hello, is this Tianfang?",
  "type": "",
  "sub": ""
 },
 {
  "front": "田芳不在。是张东吧。",
  "ar": "تيان فانغ ليست هنا. أنت تشانغ دونغ، صحيح؟",
  "en": "Tianfang isn't here. You're Zhangdong, right?",
  "type": "",
  "sub": ""
 },
 {
  "front": "阿姨，您好！田芳去哪儿了？",
  "ar": "مرحباً يا خالة! أين ذهبت تيان فانغ؟",
  "en": "Hello, Aunt! Where did Tianfang go?",
  "type": "",
  "sub": ""
 },
 {
  "front": "她四点就去同学家了。",
  "ar": "ذهبت إلى بيت صديقتها منذ الرابعة.",
  "en": "She went to her classmate's home at four.",
  "type": "",
  "sub": ""
 },
 {
  "front": "我打了。可是她关机了。",
  "ar": "لقد اتصلت. لكن هاتفها مغلق.",
  "en": "I called. But her phone was off.",
  "type": "",
  "sub": ""
 },
 {
  "front": "你过一会儿再打吧。",
  "ar": "اتصل بعد قليل.",
  "en": "Call again later.",
  "type": "",
  "sub": ""
 },
 {
  "front": "田芳回来了没有？还没有呢。",
  "ar": "هل عادت تيان فانغ؟ ليس بعد.",
  "en": "Has Tianfang come back? Not yet.",
  "type": "",
  "sub": ""
 },
 {
  "front": "啊！对了，我忘开机了。",
  "ar": "آه! صحيح، نسيت أن أشغّل الهاتف.",
  "en": "Oh! Right, I forgot to turn on the phone.",
  "type": "",
  "sub": ""
 },
 {
  "front": "今天我们跟留学生代表队比赛了。",
  "ar": "لعبنا اليوم ضد فريق الطلاب الدارسين الممثل.",
  "en": "Today we played against the international students' team.",
  "type": "",
  "sub": ""
 },
 {
  "front": "你们队又输了吧？没有。这次我们赢了。",
  "ar": "فريقكم خسر مجدداً؟ لا. هذه المرة فزنا.",
  "en": "Your team lost again? No. This time we won.",
  "type": "",
  "sub": ""
 },
 {
  "front": "几比几？二比一。祝贺你们！",
  "ar": "كم كانت النتيجة؟ ٢-١. مبروك لكم!",
  "en": "What was the score? 2-1. Congratulations!",
  "type": "",
  "sub": ""
 },
 {
  "front": "了…没有؟ / 还没…呢",
  "ar": "«了» في آخر الجملة تؤكّد حدوث الفعل. السؤال: <b>…了没有؟</b> (هل…؟). والنفي: <b>还没(有)…呢</b> (لم… بعد).<br><span style='color:var(--muted)'>你吃饭了没有？/ 我还没吃呢.</span>",
  "en": "了 at the end of a sentence confirms the action happened. Question: <b>…了没有？</b> (Did…?). Negative: <b>还没(有)…呢</b> (not… yet).<br><span style='color:var(--muted)'>你吃饭了没有？/ 我还没吃呢。</span>",
  "type": "",
  "sub": "نبرة 了 والسؤال"
 },
 {
  "front": "又 vs 再",
  "ar": "<b>又</b> = الفعل تكرّر في الماضي: <span style='color:var(--muted)'>他昨天来，今天又来了</span><br><b>再</b> = التكرار في المستقبل (لم يحدث بعد): <span style='color:var(--muted)'>明天再来</span>",
  "en": "<b>又</b> = the action repeated in the past: <span style='color:var(--muted)'>他昨天来，今天又来了</span><br><b>再</b> = repetition in the future (hasn't happened yet): <span style='color:var(--muted)'>明天再来</span>",
  "type": "",
  "sub": "تكرار الفعل"
 },
 {
  "front": "是不是 / 不是…吗؟ / 吧",
  "ar": "<b>是不是</b> = «هل…؟» وتأتي قبل الفعل أو آخر الجملة: <span style='color:var(--muted)'>你是不是忘了؟/ 你忘了，是不是؟</span><br><b>不是…吗؟</b> = سؤال تأكيدي: <span style='color:var(--muted)'>你不是要上托福班吗؟</span><br><b>吧</b> = نبرة تخمين أو اقتراح: <span style='color:var(--muted)'>你过一会儿再打吧</span>",
  "en": "<b>是不是</b> = \"Did…?\" placed before the verb or at the end: <span style='color:var(--muted)'>你是不是忘了？/ 你忘了，是不是？</span><br><b>不是…吗？</b> = confirmatory question: <span style='color:var(--muted)'>你不是要上托福班吗？</span><br><b>吧</b> = tone of guess or suggestion: <span style='color:var(--muted)'>你过一会儿再打吧</span>",
  "type": "",
  "sub": "أسئلة التأكيد"
 },
 {
